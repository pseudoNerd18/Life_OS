# ─── DATABASE ─────────────────────────────────────────────────
# Postgres + pgvector. Use docker-compose for local dev.
DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos?schema=public"

# ─── AI: OLLAMA (Local LLM) ───────────────────────────────────
# Run: docker compose up ollama  (or `ollama serve` locally)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="gemma3"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# ─── VOICE: WHISPER (Local) ───────────────────────────────────
WHISPER_MODE="local"
WHISPER_SERVER_URL="http://localhost:9000"

# Optional: a smaller model used ONLY for the live interim transcripts in
# hands-free voice mode. Leave unset and dictation still works — you just get
# the text when you stop talking instead of while you talk.
#
# Why it's opt-in: a pass on the default `small` model takes 2-7s on CPU, which
# is longer than most sentences, so partials would arrive stale and then correct
# themselves. `tiny.en` is fast enough to be useful. Pull it first:
#   curl -X POST "http://localhost:9000/api/pull/Systran/faster-whisper-tiny.en"
# WHISPER_FAST_MODEL="Systran/faster-whisper-tiny.en"

# ─── AUTH (required) ──────────────────────────────────────────
# Auth.js session signing key. Generate one with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3010"

# ─── GOOGLE SIGN-IN (public client ID — NOT a secret) ─────────
# This is the only Google value needed to sign in. A client ID is public by
# design: it ships inside the page of every Google web app. Sign-in works with
# no secret because Google Identity Services returns a signed ID token that is
# verified against Google's public keys.
#
#   1. console.cloud.google.com -> your project
#   2. APIs & Services -> Credentials -> OAuth client ID -> Web application
#   3. In the client's settings there are TWO url boxes. Sign-in uses only the
#      first one, and putting the value in the wrong box fails with
#      "Error 401: invalid_client — no registered origin":
#        Authorised JavaScript origins  ->  http://localhost:3010   <-- THIS one
#        Authorised redirect URIs       ->  (leave empty; GIS never redirects)
#      No path, no trailing slash. `127.0.0.1` is a different origin to Google,
#      so use whichever hostname you actually open in the browser.
#      Verify with: npm run check:google
#   4. Google Auth Platform -> Audience -> Test users -> add every Google
#      address you will sign in with. Sign-in alone often works without this
#      (openid/email/profile are non-sensitive), but CALENDAR scopes are
#      sensitive: while the app is in Testing mode Google refuses them for any
#      account not listed, with "Error 403: access_denied ... developer-approved
#      testers". Testing mode also expires refresh tokens after 7 days.
#   5. Paste below, restart the dev server, then: npm run check:google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ─── GOOGLE CALENDAR (optional, needs a real secret) ──────────
# Two-way calendar sync uses the authorization-code flow, and Google will not
# issue a refresh token without a client secret. Leave these empty to keep this
# machine free of secrets: sign-in still works, and the calendar shows internal
# events only. Configure them where the app is deployed if you want sync there.
# Redirect URI: http://localhost:3010/api/calendar/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── APP ──────────────────────────────────────────────────────
APP_URL="http://localhost:3010"
NODE_ENV="development"

# ─── REMINDER CALLS: TWILIO (optional) ────────────────────────
# Rings your phone two minutes before a calendar event starts. Save the number
# to call on the Today page; these three values are the line it calls *from*.
# Leave them empty and everything else works — the card on Today just says
# calling isn't configured.
#
#   1. console.twilio.com -> Account Info: copy the Account SID and Auth Token
#   2. Phone Numbers -> Manage -> Active numbers: buy or pick one with Voice
#      capability, and paste it below in E.164 (+countrycode, no spaces)
#   3. TRIAL ACCOUNTS CANNOT NAME THE EVENT. A trial may only dial *verified*
#      numbers, and may not send its own TwiML — it is limited to `To`,
#      `StatusCallback` and four Twilio-hosted templates, so the reminder text
#      is ignored (https://www.twilio.com/docs/usage/trials/try-out-voice).
#      The app detects this and falls back to a template, so the phone still
#      rings two minutes before the event; it just doesn't say which one.
#      Upgrading the Twilio account restores the spoken event name on its own —
#      there is no code change or setting to flip.
#      Verify your mobile under Phone Numbers -> Verified Caller IDs.
#
#   4. Calling an Indian (+91) mobile requires an international From number —
#      outbound calls from +91 Twilio numbers were discontinued in Aug 2024.
#      A US (+1) number works. See twilio.com/en-us/guidelines/in/voice
#
# The sweep runs in-process once a minute (src/instrumentation.ts), so calls
# only happen while the server is running.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Public URL of this app's /api/calls/twiml route, which speaks the reminder.
#
# LEAVE THIS EMPTY. When Twilio is configured and this is blank, the server
# starts a cloudflared quick tunnel at boot and fills it in automatically
# (src/lib/calls/tunnel.ts). Requires `brew install cloudflared`.
#
# Set it only if you host the app somewhere public already, e.g.
#   TWILIO_TWIML_URL="https://your-app.example.com/api/calls/twiml"
#
# Two dead ends, so nobody retries them:
#   * Inline TwiML — a Twilio TRIAL account rejects the `Twiml` parameter.
#   * A TwiML Bin — Twilio rewrites the URL before fetching it and decodes
#     percent-escapes, so a `%26` arrives as a bare `&` and truncates the
#     message. Any event named "Design & Review" fails, and it looks like an
#     unreachable server. The route avoids this by packing the message as
#     base64url; a Bin cannot, because its template reads the raw parameter.
#
# The endpoint is world-reachable, so every request carries an HMAC over the
# message keyed on AUTH_SECRET. It renders nothing without a valid signature.
TWILIO_TWIML_URL=""
