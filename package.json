{
  "name": "life-os",
  "version": "0.5.0",
  "private": true,
  "description": "AI-native Life OS — conversational assistant for tasks, goals, notes, and calendar. Local-first inference, two-way Google Calendar sync, and reminder phone calls.",
  "scripts": {
    "dev": "next dev -p 3010",
    "kill": "bash scripts/kill-servers.sh",
    "build": "prisma generate && next build",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run test:unit",
    "postinstall": "prisma generate || true",
    "test:notes": "node scripts/e2e-notes.mjs",
    "test:calendar": "tsx scripts/test-calendar-sync.ts",
    "check:google": "node scripts/check-google.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@blocknote/ariakit": "^0.54.0",
    "@blocknote/core": "^0.54.0",
    "@blocknote/react": "^0.54.0",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-avatar": "1.1.1",
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-popover": "1.1.2",
    "@radix-ui/react-scroll-area": "1.2.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-separator": "1.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.3",
    "bcryptjs": "^3.0.3",
    "chrono-node": "2.7.7",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "11.11.9",
    "jose": "^6.2.10",
    "lucide-react": "0.452.0",
    "nanoid": "5.1.16",
    "next": "15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "0.3.0",
    "ollama": "0.5.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "rrule": "2.8.1",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.25.76",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.7.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "playwright": "^1.62.1",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.23.12",
    "typescript": "5.6.3",
    "vitest": "^4.1.11"
  }
}
